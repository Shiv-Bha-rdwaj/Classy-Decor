<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classy Decor | Home Designing & Interior Inspiration</title>
    <!-- Google Fonts & FontAwesome for Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #1A1A1A;
            --accent: #C5A059;
            --light: #F9F8F6;
            --white: #FFFFFF;
            --gray: #777777;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--light);
            color: var(--primary);
            line-height: 1.6;
        }

        h1, h2, h3, .logo-text {
            font-family: 'Playfair Display', serif;
        }

        /* Header & Logo */
        header {
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            z-index: 1000;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-badge {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--accent), #E2C284);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 22px;
            box-shadow: 0 4px 10px rgba(197, 160, 89, 0.3);
        }

        .logo-text h1 {
            font-size: 1.6rem;
            letter-spacing: 0.5px;
            color: var(--primary);
            line-height: 1.1;
        }

        .logo-text span {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--accent);
            font-weight: 600;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .header-contact {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--primary);
        }

        .header-contact span {
            color: var(--accent);
        }

        /* Hero Section */
        .hero {
            position: relative;
            height: 75vh;
            background: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--white);
            padding: 0 20px;
        }

        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
        }

        .hero-content h2 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .hero-content p {
            font-size: 1.2rem;
            font-weight: 300;
            margin-bottom: 30px;
            opacity: 0.9;
        }

        /* Gallery Section */
        .gallery-container {
            max-width: 1400px;
            margin: 80px auto;
            padding: 0 5%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .section-title p {
            color: var(--gray);
            font-size: 1.05rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
        }

        .card {
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .card-img {
            height: 280px;
            width: 100%;
            overflow: hidden;
        }

        .card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .card:hover .card-img img {
            transform: scale(1.05);
        }

        .card-body {
            padding: 25px;
        }

        .card-body h3 {
            font-size: 1.3rem;
            margin-bottom: 8px;
        }

        .card-body p {
            color: var(--gray);
            font-size: 0.95rem;
        }

        /* Floating Action Buttons */
        .action-dock {
            position: fixed;
            bottom: 30px;
            right: 30px;
            display: flex;
            gap: 15px;
            z-index: 9999;
        }

        .btn-action {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            color: var(--white);
            font-size: 26px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.25);
            text-decoration: none;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .btn-action:hover {
            transform: scale(1.1);
        }

        .btn-whatsapp {
            background-color: #25D366;
        }

        .btn-phone {
            background-color: var(--accent);
        }

        /* Footer */
        footer {
            background: var(--primary);
            color: var(--white);
            text-align: center;
            padding: 40px 20px;
            margin-top: 100px;
        }

        footer p {
            opacity: 0.8;
            font-size: 0.95rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-content h2 {
                font-size: 2.3rem;
            }
            header {
                padding: 15px 5%;
            }
            .header-contact {
                display: none;
            }
        }
    </style>
</head>
<body>

